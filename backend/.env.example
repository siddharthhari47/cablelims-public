# CableLIMS runtime configuration (H14).
#
# Copy this file to `.env` (same directory) and edit the values you want to
# change. Anything left commented out uses the default shown here. Every
# variable is also settable directly in the environment (e.g. via Windows
# Task Scheduler's action config) with the same name -- a `.env` file is a
# convenience, not the only way to set these.
#
# This file documents every operationally-tunable value in the app (see
# app/config.py's own docstring for what is deliberately NOT here, and why).

# -- Authentication / sessions ------------------------------------------------
# How long an access token stays valid before requiring a fresh login.
# CABLELIMS_ACCESS_TOKEN_EXPIRE_HOURS=12

# -- Login throttling (services/login_throttle.py) ---------------------------
# Failed login attempts (same username+source IP) before that pair is locked out.
# CABLELIMS_LOGIN_MAX_FAILURES=5
# How long a triggered lockout lasts, in seconds.
# CABLELIMS_LOGIN_LOCKOUT_SECONDS=900
# A failure older than this doesn't count toward the lockout threshold.
# CABLELIMS_LOGIN_FAILURE_WINDOW_SECONDS=900

# -- Uploads (services/image_upload.py) ---------------------------------------
# Maximum accepted size for an uploaded marking/diagram photo, in bytes.
# CABLELIMS_MAX_UPLOAD_BYTES=10485760
# JPEG re-encode quality (1-95) every uploaded image is normalized to.
# CABLELIMS_UPLOAD_JPEG_QUALITY=85

# -- Logging (logging_config.py) ----------------------------------------------
# Rotate backend/logs/cablelims.log once it reaches this size, in bytes.
# CABLELIMS_LOG_MAX_BYTES=5242880
# How many rotated log files to keep before the oldest is deleted.
# CABLELIMS_LOG_BACKUP_COUNT=5

# -- Backups (backup.py) -------------------------------------------------------
# How many timestamped backups run_backup() keeps before pruning the oldest.
# CABLELIMS_BACKUP_DEFAULT_KEEP=30

# -- Health check (main.py) ----------------------------------------------------
# /api/health reports "degraded" once free disk space on the data volume
# drops below this, in bytes.
# CABLELIMS_LOW_DISK_SPACE_BYTES=524288000

# -- Database (db.py) -----------------------------------------------------------
# SQLite busy_timeout -- how long a writer waits for a lock held by another
# connection before failing outright, in milliseconds.
# CABLELIMS_DB_BUSY_TIMEOUT_MS=5000

# -- CORS (main.py) ---------------------------------------------------------------
# Origins allowed to call the API cross-origin, comma-separated. Defaults to
# the local Vite dev server only -- the documented deployment (this backend
# serves the built frontend on its own origin) never needs a cross-origin
# allowance at all, since the browser's requests are same-origin either way.
# Only set this if you're running a non-standard deployment where the
# frontend is genuinely hosted on a different origin than this backend --
# e.g. a separate IIS/Nginx site serving frontend/dist while this API runs
# on its own port. List every real frontend origin explicitly (scheme +
# host + port); "*" is deliberately not offered as a default anymore.
# CABLELIMS_CORS_ALLOWED_ORIGINS=http://192.168.1.50:8080,http://cablelims.local

# -- JWT signing secret (services/auth_service.py) -----------------------------
# NOT read through app/config.py's Settings class (deliberately -- see its
# docstring) so it can never end up in a settings dump/log. If unset, one is
# generated automatically on first run and persisted to backend/data/.secret_key
# -- set this explicitly only if you need a specific, pre-provisioned key.
# CABLELIMS_SECRET_KEY=
